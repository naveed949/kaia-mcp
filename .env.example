# Kaia RPC endpoint (required for chain reads/writes)
KAIA_RPC_URL=https://public-en.node.kaia.io

# Kaia Kairos RPC (optional; for Kairos-specific features)
KAIA_KAIROS_RPC_URL=

# KaiaScan API key (optional; for history, verified contracts, etc.)
KAIASCAN_API_KEY=

# Default network: mainnet | kairos
KAIA_DEFAULT_NETWORK=mainnet

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Rate limit: max RPC requests per second
RATE_LIMIT_RPC=10

# Rate limit: max KaiaScan API requests per second
RATE_LIMIT_KAIASCAN=5

# RPC request timeout in milliseconds (default 30000)
# RPC_TIMEOUT_MS=30000

# KaiaScan request timeout in milliseconds (default 15000)
# KAIASCAN_TIMEOUT_MS=15000

# HTTP partner auth: required (default) | off (local unauthenticated HTTP only)
# KAIA_AUTH_MODE=required

# Demo OAuth public client id (in-process mock IdP; no real secrets)
# KAIA_OAUTH_CLIENT_ID=kaia-mcp-demo

# Access token lifetime in seconds (demo IdP)
# KAIA_ACCESS_TOKEN_TTL_SECONDS=900

# Public origin (no path): OAuth issuer, canonical resource URI (token aud), default allowed Origin.
# Unset: http://127.0.0.1:<port>
# KAIA_PUBLIC_URL=https://kaia.example.com

# Extra aud minted next to the canonical URI for gateways that pin a non-URI audience.
# Never accepted on its own. (KAIA_OAUTH_AUDIENCE is a deprecated alias.)
# KAIA_OAUTH_LEGACY_AUDIENCE=kaia-mcp

# Reject OAuth requests without an RFC 8707 resource parameter (default: missing = this server)
# KAIA_OAUTH_REQUIRE_RESOURCE=0

# Extra browser origins allowed on MCP/OAuth endpoints (comma-separated). Foreign Origin -> 403.
# KAIA_ALLOWED_ORIGINS=http://localhost:6274

# Retired signing keys still published in the JWKS and accepted (comma-separated PEM paths)
# KAIA_OAUTH_PREVIOUS_SIGNING_KEY_FILES=

# Optional dev signing key path (gitignored). Unset: a fresh RS256 key per process.
# KAIA_OAUTH_SIGNING_KEY_FILE=.kaia-dev/signing-key.pem

# RFC 7662 introspection for a gateway (client_secret_basic). Unset secret: endpoint not offered.
# KAIA_INTROSPECTION_CLIENT_ID=kaia-mcp-gateway
# KAIA_INTROSPECTION_CLIENT_SECRET=

# UNSAFE local-dev only. When unset/false, generate_wallet is omitted and refuses to return private keys.
# KAIA_ALLOW_UNSAFE_WALLET=0
