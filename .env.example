# Kaia RPC endpoint (required for chain reads/writes)
KAIA_RPC_URL=https://public-en.node.kaia.io

# Kaia Kairos RPC (optional; for Kairos-specific features)
KAIA_KAIROS_RPC_URL=

# KaiaScan API key (optional; for history, verified contracts, etc.)
KAIASCAN_API_KEY=

# Default network: mainnet | kairos
KAIA_DEFAULT_NETWORK=mainnet

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Rate limit: max RPC requests per second
RATE_LIMIT_RPC=10

# Rate limit: max KaiaScan API requests per second
RATE_LIMIT_KAIASCAN=5

# RPC request timeout in milliseconds (default 30000)
# RPC_TIMEOUT_MS=30000

# KaiaScan request timeout in milliseconds (default 15000)
# KAIASCAN_TIMEOUT_MS=15000

# HTTP partner auth: required (default) | off (local unauthenticated HTTP only)
# KAIA_AUTH_MODE=required

# Demo OAuth public client id (in-process mock IdP; no real secrets)
# KAIA_OAUTH_CLIENT_ID=kaia-mcp-demo

# Access token lifetime in seconds (demo IdP)
# KAIA_ACCESS_TOKEN_TTL_SECONDS=900

# UNSAFE local-dev only. When unset/false, generate_wallet is omitted and refuses to return private keys.
# KAIA_ALLOW_UNSAFE_WALLET=0
